digraph G { fontname="Helvetica"; rankdir=LR; nodesep=0.6; ranksep=1.0; node [fontname="Helvetica", fontsize=11, shape=circle, width=1.35, fixedsize=true, style=filled, fillcolor="#f4f6f8", color="#51606e"]; edge [fontname="Helvetica", fontsize=9, color="#51606e"];
